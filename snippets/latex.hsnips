\nabla ${1:f}$0
endsnippet

context math(context)
snippet divg "Divergence" Aw
\nabla \cdot ${1:\vec{F}}$0
endsnippet

context math(context)
snippet curl "Curl" Aw
\nabla \times ${1:\vec{F}}$0
endsnippet

context math(context)
snippet lapl "Laplacian" Aw
\nabla^{2} ${1:f}$0
endsnippet

context math(context)
snippet dotp "Dot product" Aw
${1:\vec{u}} \cdot ${2:\vec{v}}$0
endsnippet

context math(context)
snippet crossp "Cross product" Aw
${1:\vec{u}} \times ${2:\vec{v}}$0
endsnippet


# ============================================================
# Editable matrices
# ============================================================

# Press Tab to expand; each cell is an editable placeholder.
context math(context)
snippet mat2 "2 by 2 matrix" w
\begin{pmatrix}
    ${1:a} & ${2:b} \\\\
    ${3:c} & ${4:d}
\end{pmatrix}$0
endsnippet

context math(context)
snippet mat3 "3 by 3 matrix" w
\begin{pmatrix}
    ${1:a} & ${2:b} & ${3:c} \\\\
    ${4:d} & ${5:e} & ${6:f} \\\\
    ${7:g} & ${8:h} & ${9:i}
\end{pmatrix}$0
endsnippet


# ============================================================
# Generated matrices
# ============================================================

# Examples: 2x3mat, 2x3bmat
# Replace the square placeholders manually.
context math(context)
snippet `(^|[^\\A-Za-z0-9])([1-6])x([1-6])(b?)mat` "Matrix from dimensions" A
``
rv = m[1] + matrix(
    Number(m[2]),
    Number(m[3]),
    () => "\\square",
    m[4] ? "bmatrix" : "pmatrix"
);
``$0
endsnippet

# Example: 3imat
context math(context)
snippet `(^|[^\\A-Za-z0-9])([1-6])imat` "Identity matrix" A
``
rv = m[1] + matrix(
    Number(m[2]),
    Number(m[2]),
    (row, col) => row === col ? "1" : "0"
);
``$0
endsnippet


# ============================================================
# Greek letters
# ============================================================

# Examples: ;a -> \alpha{}, ;q -> \theta{}
context math(context)
snippet `;([abgdezhqiklmnxoprstufcyw])` "Lowercase Greek" A
``rv = terminateCommand(greekLower[m[1]])``$0
endsnippet

# Examples: :G -> \Gamma{}, :A -> A
context math(context)
snippet `:([ABGDEZHQIKLMNXOPRSTUFCYW])` "Uppercase Greek" A
``rv = terminateCommand(greekUpper[m[1]])``$0
endsnippet


