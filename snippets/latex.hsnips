global
function hasScope(context, prefix) {
    return context.scopes.some(
        scope => scope === prefix || scope.startsWith(prefix + ".")
    );
}

function comment(context) {
    return hasScope(context, "comment");
}

function inMath(context) {
    return hasScope(context, "meta.math");
}

function math(context) {
    return inMath(context)
        && !comment(context)
        && !hasScope(context, "meta.text.normal");
}

function prose(context) {
    return !inMath(context) && !comment(context);
}

function editable(context) {
    return !comment(context);
}

const greekLower = {
    a: "\\alpha",
    b: "\\beta",
    g: "\\gamma",
    d: "\\delta",
    e: "\\epsilon",
    z: "\\zeta",
    h: "\\eta",
    q: "\\theta",
    i: "\\iota",
    k: "\\kappa",
    l: "\\lambda",
    m: "\\mu",
    n: "\\nu",
    x: "\\xi",
    o: "o",
    p: "\\pi",
    r: "\\rho",
    s: "\\sigma",
    t: "\\tau",
    u: "\\upsilon",
    f: "\\phi",
    c: "\\chi",
    y: "\\psi",
    w: "\\omega"
};

const greekUpper = {
    A: "A",
    B: "B",
    G: "\\Gamma",
    D: "\\Delta",
    E: "E",
    Z: "Z",
    H: "H",
    Q: "\\Theta",
    I: "I",
    K: "K",
    L: "\\Lambda",
    M: "M",
    N: "N",
    X: "\\Xi",
    O: "O",
    P: "\\Pi",
    R: "P",
    S: "\\Sigma",
    T: "T",
    U: "\\Upsilon",
    F: "\\Phi",
    C: "X",
    Y: "\\Psi",
    W: "\\Omega"
};

function terminateCommand(value) {
    return value.startsWith("\\") ? value + "{}" : value;
}

function removeEmptyTerminator(value) {
    return value.replace(/\{\}$/, "");
}

function power(order) {
    return Number(order) === 1 ? "" : "^{" + order + "}";
}

function partialFactor(variable, order) {
    return "\\partial " + variable + power(order);
}

function mixedDenominator(firstVariable, firstOrder,
                          secondVariable, secondOrder) {
    if (firstVariable === secondVariable) {
        return partialFactor(
            firstVariable,
            Number(firstOrder) + Number(secondOrder)
        );
    }

    return partialFactor(firstVariable, firstOrder)
        + " "
        + partialFactor(secondVariable, secondOrder);
}

function matrixBody(rows, cols, cell) {
    const lines = [];

    for (let row = 0; row < rows; row++) {
        const cells = [];

        for (let col = 0; col < cols; col++) {
            cells.push(cell(row, col));
        }

        lines.push("    " + cells.join(" & "));
    }

    return lines.join(" " + "\\".repeat(4) + "\n");
}
endglobal


# ============================================================
# ENTERING MATH AND ENVIRONMENTS
# ============================================================

context editable(context)
snippet m$ "Display math" Ai
\[
    $1$0
\]
endsnippet

context editable(context)
snippet $$ "Inline math" Ai
$ $1$0 $
endsnippet

# Available inside and outside math, but not comments.
# Tab-triggered to avoid expanding while typing ordinary words.
context editable(context)
snippet begin "Begin environment" w
\begin{${1:aligned}}
    $0
\end{$1}
endsnippet


# ============================================================
# BASIC MATH
# ============================================================

context math(context)
snippet sr "Square root" Ai
\sqrt{$1}$0
endsnippet

context math(context)
snippet nr "Nth root" Ai
\sqrt[${1:n}]{$2}$0
endsnippet

context math(context)
snippet ff "Fraction" Ai
\frac{$1}{$2}$0
endsnippet

context math(context)
snippet abs "Absolute value" Aw
\left\lvert $1 \right\rvert$0
endsnippet

context math(context)
snippet nn "Norm" Ai
\left\lVert $1 \right\rVert$0
endsnippet

context math(context)
snippet ^ "Superscript" Ai
^{$1}$0
endsnippet

context math(context)
snippet _ "Subscript" Ai
_{$1}$0
endsnippet


# ============================================================
# POSTFIX FRACTIONS
#
# Supported:
#   x//
#   12//
#   \alpha{}//
#   x^{2}//
#   x_{i}^{2}//
#   (x+y)//
#
# Intentionally excludes nested groups and implicit products.
# ============================================================

context math(context)
snippet `(^|[^\\A-Za-z0-9_{}])((?:\\[A-Za-z]+(?:\{\})?|[A-Za-z]|[0-9]+)(?:[_^](?:\{[^{}\n]+\}|[A-Za-z0-9]))*)//` "Atom to fraction" A
``rv = m[1]``\frac{``rv = m[2]``}{$1}$0
endsnippet

# Do not match the (...) part of \left(...).
context math(context)
snippet `(^|[^\\A-Za-z0-9])\(([^()\n]+)\)//` "Grouped expression to fraction" A
``rv = m[1]``\frac{``rv = m[2]``}{$1}$0
endsnippet


# ============================================================
# DERIVATIVES
#
# pd and dv require Tab:
# automatic expansion would interrupt longer derivative triggers.
# ============================================================

context math(context)
snippet pd "Partial derivative" w
\frac{\partial ${1:f}}{\partial ${2:x}}$0
endsnippet

context math(context)
snippet dv "Ordinary derivative" w
\frac{\mathrm{d} ${1:f}}{\mathrm{d} ${2:x}}$0
endsnippet

context math(context)
snippet `(^|[^\\A-Za-z0-9])([2-9])pd` "Higher-order partial derivative" A
``rv = m[1]``\frac{\partial^{``rv = m[2]``} ${1:f}}{\partial ${2:x}^{``rv = m[2]``}}$0
endsnippet

context math(context)
snippet `(^|[^\\A-Za-z0-9])([2-9])dv` "Higher-order ordinary derivative" A
``rv = m[1]``\frac{\mathrm{d}^{``rv = m[2]``} ${1:f}}{\mathrm{d} ${2:x}^{``rv = m[2]``}}$0
endsnippet

# Examples:
#   pdxy
#   pd2x3y
#   pdxx       -> combines repeated variables into x^2
context math(context)
snippet `(^|[^\\A-Za-z0-9])pd([1-9]?)([xyz])([1-9]?)([xyz])` "Mixed partial derivative" A
``rv = m[1]``\frac{\partial^{``rv = Number(m[2] || 1) + Number(m[4] || 1)``} ${1:f}}{``rv = mixedDenominator(m[3], m[2] || 1, m[5], m[4] || 1)``}$0
endsnippet


# ============================================================
# VECTORS
# ============================================================

context math(context)
snippet vv "Vector" Ai
\vec{$1}$0
endsnippet

context math(context)
snippet VV "Unit vector" Ai
\hat{$1}$0
endsnippet

# Accept both manually typed commands and Greek snippet output:
#   xvec
#   \alphavec
#   \alpha{}vec
context math(context)
snippet `(^|[^\\A-Za-z0-9_{}])(\\[A-Za-z]+(?:\{\})?|[A-Za-z])vec` "Vector of preceding atom" A
``rv = m[1]``\vec{``rv = removeEmptyTerminator(m[2])``}$0
endsnippet

context math(context)
snippet `(^|[^\\A-Za-z0-9_{}])(\\[A-Za-z]+(?:\{\})?|[A-Za-z])VEC` "Unit vector of preceding atom" A
``rv = m[1]``\hat{``rv = removeEmptyTerminator(m[2])``}$0
endsnippet


# ============================================================
# EDITABLE MATRICES
#
# Explicit tab stops for common sizes.
# Tab activation prevents the generic matrix rule from
# interrupting these short triggers.
# ============================================================

context math(context)
snippet mat2 "Editable 2 by 2 matrix" w
\begin{pmatrix}
    ${1:a} & ${2:b} \\\\
    ${3:c} & ${4:d}
\end{pmatrix}$0
endsnippet

context math(context)
snippet mat3 "Editable 3 by 3 matrix" w
\begin{pmatrix}
    ${1:a} & ${2:b} & ${3:c} \\\\
    ${4:d} & ${5:e} & ${6:f} \\\\
    ${7:g} & ${8:h} & ${9:i}
\end{pmatrix}$0
endsnippet


# ============================================================
# GENERATED MATRICES
#
# These generate ordinary LaTeX, not dynamic tab stops.
# Replace each \square manually.
#
#   2x3mat -> parenthesized matrix
#   2x3bmat -> square-bracketed matrix
#   3imat -> identity matrix
# ============================================================

context math(context)
snippet `(^|[^\\A-Za-z0-9])([1-6])x([1-6])(b?)mat` "Matrix from dimensions" A
``rv = m[1] + "\\begin{" + (m[4] ? "bmatrix" : "pmatrix") + "}\n" + matrixBody(Number(m[2]), Number(m[3]), () => "\\square") + "\n\\end{" + (m[4] ? "bmatrix" : "pmatrix") + "}"``$0
endsnippet

context math(context)
snippet `(^|[^\\A-Za-z0-9])([1-6])imat` "Identity matrix" A
``rv = m[1] + "\\begin{pmatrix}\n" + matrixBody(Number(m[2]), Number(m[2]), (row, col) => row === col ? "1" : "0") + "\n\\end{pmatrix}"``$0
endsnippet


# ============================================================
# GREEK LETTERS
#
# Keep your existing trigger scheme:
#   ;a -> lowercase
#   :G -> uppercase
# ============================================================

context math(context)
snippet `;([abgdezhqiklmnxoprstufcyw])` "Lowercase Greek" A
``rv = terminateCommand(greekLower[m[1]])``$0
endsnippet

context math(context)
snippet `:([ABGDEZHQIKLMNXOPRSTUFCYW])` "Uppercase Greek" A
``rv = terminateCommand(greekUpper[m[1]])``$0
endsnippet