# ============================================================
# Math modes and environments
# ============================================================

context prose(context)
snippet m$ "Display math" Ai
\[
    $1$0
\]
endsnippet

context prose(context)
snippet $$ "Inline math" Ai
$ $1$0 $
endsnippet

# Press Tab to expand; available outside comments.
context !comment(context)
snippet begin "Environment" w
\begin{${1:aligned}}
    $0
\end{$1}
endsnippet


# ============================================================
# Basic math
# ============================================================

context math(context)
snippet sr "Square root" Ai
\sqrt{$1}$0
endsnippet

context math(context)
snippet nr "Nth root" Ai
\sqrt[${1:n}]{$2}$0
endsnippet

context math(context)
snippet abs "Absolute value" Aw
\left\lvert $1 \right\rvert$0
endsnippet

context math(context)
snippet nn "Norm" Ai
\left\lVert $1 \right\rVert$0
endsnippet

context math(context)
snippet ^ "Superscript" Ai
^{$1}$0
endsnippet

context math(context)
snippet _ "Subscript" Ai
_{$1}$0
endsnippet


# ============================================================
# Fractions
# ============================================================

context math(context)
snippet ff "Fraction" Ai
\frac{$1}{$2}$0
endsnippet

# Examples: x//, 12//, \alpha{}//, x_{i}^{2}//
# Handles simple atoms and scripts, not nested groups.
context math(context)
snippet `(^|[^\\A-Za-z0-9_{}])((?:\\[A-Za-z]+(?:\{\})?|[A-Za-z]|[0-9]+)(?:[_^](?:\{[^{}\n]+\}|[A-Za-z0-9]))*)//` "Atom to fraction" A
``rv = m[1]``\frac{``rv = m[2]``}{$1}$0
endsnippet

# Example: (x+y)//; removes the outer parentheses.
context math(context)
snippet `(^|[^\\A-Za-z0-9])\(([^()\n]+)\)//` "Grouped expression to fraction" A
``rv = m[1]``\frac{``rv = m[2]``}{$1}$0
endsnippet


# ============================================================
# Derivatives
# ============================================================

# Press Tab for pd and dv so longer triggers remain available.
context math(context)
snippet pd "Partial derivative" w
\frac{\partial ${1:f}}{\partial ${2:x}}$0
endsnippet

context math(context)
snippet dv "Ordinary derivative" w
\frac{\mathrm{d} ${1:f}}{\mathrm{d} ${2:x}}$0
endsnippet

# Examples: 2pd, 3pd
# The denominator placeholder expects a single variable.
context math(context)
snippet `(^|[^\\A-Za-z0-9])([2-9])pd` "Higher-order partial derivative" A
``rv = m[1]``\frac{\partial^{``rv = m[2]``} ${1:f}}{\partial ${2:x}^{``rv = m[2]``}}$0
endsnippet

# Examples: 2dv, 3dv
context math(context)
snippet `(^|[^\\A-Za-z0-9])([2-9])dv` "Higher-order ordinary derivative" A
``rv = m[1]``\frac{\mathrm{d}^{``rv = m[2]``} ${1:f}}{\mathrm{d} ${2:x}^{``rv = m[2]``}}$0
endsnippet

# Examples: pdxy, pd2x3y
# Repeated variables combine: pdxx uses a second power of x.
context math(context)
snippet `(^|[^\\A-Za-z0-9])pd([1-9]?)([xyz])([1-9]?)([xyz])` "Coordinate mixed partial derivative" A
``rv = m[1]``\frac{\partial^{``rv = Number(m[2] || 1) + Number(m[4] || 1)``} ${1:f}}{``rv = mixedDenominator(m[3], m[2] || 1, m[5], m[4] || 1)``}$0
endsnippet


# ============================================================
# Vectors
# ============================================================

context math(context)
snippet vv "Vector" Ai
\vec{$1}$0
endsnippet

context math(context)
snippet VV "Unit vector" Ai
\hat{$1}$0
endsnippet

# Examples: xvec, \alphavec, \alpha{}vec
context math(context)
snippet `(^|[^\\A-Za-z0-9_{}])(\\[A-Za-z]+(?:\{\})?|[A-Za-z])vec` "Atom to vector" A
``rv = m[1]``\vec{``rv = removeEmptyTerminator(m[2])``}$0
endsnippet

context math(context)
snippet `(^|[^\\A-Za-z0-9_{}])(\\[A-Za-z]+(?:\{\})?|[A-Za-z])VEC` "Atom to unit vector" A
``rv = m[1]``\hat{``rv = removeEmptyTerminator(m[2])``}$0
endsnippet


