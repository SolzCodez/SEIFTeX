# ============================================================
# Derivatives
# ============================================================

# Press Tab for pd and dv so longer triggers remain available.
context math(context)
snippet pd "Partial derivative" w
\frac{\partial ${1:f}}{\partial ${2:x}}$0
endsnippet

context math(context)
snippet dv "Ordinary derivative" w
\frac{\mathrm{d} ${1:f}}{\mathrm{d} ${2:x}}$0
endsnippet

# Examples: 2pd, 3pd
# The denominator placeholder expects a single variable.
context math(context)
snippet `(^|[^\\A-Za-z0-9])([2-9])pd` "Higher-order partial derivative" A
``rv = m[1]``\frac{\partial^{``rv = m[2]``} ${1:f}}{\partial ${2:x}^{``rv = m[2]``}}$0
endsnippet

# Examples: 2dv, 3dv
context math(context)
snippet `(^|[^\\A-Za-z0-9])([2-9])dv` "Higher-order ordinary derivative" A
``rv = m[1]``\frac{\mathrm{d}^{``rv = m[2]``} ${1:f}}{\mathrm{d} ${2:x}^{``rv = m[2]``}}$0
endsnippet

# Examples: pdxy, pd2x3y
# Repeated variables combine: pdxx uses a second power of x.
context math(context)
snippet `(^|[^\\A-Za-z0-9])pd([1-9]?)([xyz])([1-9]?)([xyz])` "Coordinate mixed partial derivative" A
``rv = m[1]``\frac{\partial^{``rv = Number(m[2] || 1) + Number(m[4] || 1)``} ${1:f}}{``rv = mixedDenominator(m[3], m[2] || 1, m[5], m[4] || 1)``}$0
endsnippet